# Database (Neon)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=
GEMINI_COMBINED_TOOLS=false

# Pipeline
IDENTIFY_CONFIDENCE_MIN=0.75
MAX_LEADS=2
STAGE_TIMEOUT_MS=25000
MAX_IMAGES=8
MAX_IMAGE_BYTES=8000000
PIPELINE_VERSION=2
CACHE_MODE=off

# Extension
ALLOWED_EXTENSION_ORIGINS=
ALLOWED_WEB_ORIGINS=
