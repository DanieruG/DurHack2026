# Database (Neon)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon branch for test runs (eval, reruns, DB integration tests); never the main database
TEST_DATABASE_URL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=
GEMINI_COMBINED_TOOLS=false

# New retail prices (SerpApi Google Shopping)
SHOPPING_API_KEY=

# Pipeline
IDENTIFY_CONFIDENCE_MIN=0.75
MAX_LEADS=2
STAGE_TIMEOUT_MS=25000
SEARCH_TIMEOUT_MS=10000
PRO_RECHECK_TIMEOUT_MS=15000
MAX_IMAGES=8
MAX_IMAGE_BYTES=8000000
PIPELINE_VERSION=2
CACHE_MODE=off

# Extension (the manifest key pins the unpacked extension's ID)
ALLOWED_EXTENSION_ORIGINS=chrome-extension://appjiengjbolgmppilkllgmnmoogpiej
ALLOWED_WEB_ORIGINS=
